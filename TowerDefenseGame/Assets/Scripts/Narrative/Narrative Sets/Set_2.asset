%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02ff5e751dcfd764781b6d35bf16d1e0, type: 3}
  m_Name: Set_2
  m_EditorClassIdentifier: 
  setName: The Teen Queen
  narrativeSet:
  - paragraph: "The young queen grips her father\u2019s sword. It\u2019s too heavy
      for her hands, but the goblins won\u2019t wait for her to grow stronger. At
      only 14 she seats herself on the throne."
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 0
    econ: 0
    infrastructure: {fileID: 0}
    towerHealth: 0
  - paragraph: "Skeletons crawl through the broken gate. The queen stands on the
      wall, voice trembling yet clear \u2014 \u201CHold the line!\u201D"
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 1
    econ: 0
    infrastructure: {fileID: 0}
    towerHealth: -100
  - paragraph: "Trolls batter the northern tower. The stones quake, but the queen
      refuses to flee. \u201CIf the castle falls, I fall with it.\u201D"
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 0
    econ: 0
    infrastructure: {fileID: 11400000, guid: 9ab883eb9ce71c843ba63c82619b7649, type: 2}
    towerHealth: 0
  - paragraph: We have little to feed the kingdom, plans will be drawn, and food
      will be grown.
    addEcon: 1
    addInfrastructure: 1
    addTowerHealth: 0
    econ: -20
    infrastructure: {fileID: 11400000, guid: 9ab883eb9ce71c843ba63c82619b7649, type: 2}
    towerHealth: 0
  - paragraph: "A messenger kneels before her. \u201CThe miners found gold, Your
      Grace.\u201D She smiles faintly \u2014 one small victory in a sea of ruin."
    addEcon: 1
    addInfrastructure: 0
    addTowerHealth: 0
    econ: 500
    infrastructure: {fileID: 11400000, guid: 9ab883eb9ce71c843ba63c82619b7649, type: 2}
    towerHealth: 0
  - paragraph: "Goblin raiders steal into the armory at dusk. The queen orders a
      trap \u2014 clever, brutal, and hers alone."
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 1
    econ: 0
    infrastructure: {fileID: 11400000, guid: 9ab883eb9ce71c843ba63c82619b7649, type: 2}
    towerHealth: 100
  - paragraph: A scout brings word of a hidden mine deep in the hills. The queen
      sends her bravest knights, dreaming of gold and peace.
    addEcon: 0
    addInfrastructure: 1
    addTowerHealth: 0
    econ: 0
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: 0
  - paragraph: "The castle\u2019s eastern wing collapses in smoke and screams. Still,
      the young queen orders her banners raised high."
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 1
    econ: 0
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: -200
  - paragraph: The blacksmith forges weapons through the night. The queen visits,
      barefoot, watching each strike with awe and fury.
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 0
    econ: 0
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: 0
  - paragraph: "The miners strike silver instead of gold. The queen laughs softly
      \u2014 \u201CEven the earth mocks me.\u201D"
    addEcon: 1
    addInfrastructure: 0
    addTowerHealth: 0
    econ: -100
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: 0
  - paragraph: "The treasury empties again, but the castle stands. \u201CWe are not
      poor,\u201D she says. \u201CWe are alive.\u201D"
    addEcon: 1
    addInfrastructure: 0
    addTowerHealth: 0
    econ: -400
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: 0
  - paragraph: A storm batters the battlements. The queen stands upon the tower,
      rain mixing with tears she will never shed before her people.
    addEcon: 0
    addInfrastructure: 0
    addTowerHealth: 1
    econ: 0
    infrastructure: {fileID: 11400000, guid: f1cc8a616fa2bfb408428e59980c6b38, type: 2}
    towerHealth: 50
  - paragraph: '"Bring peace to the people", the queen orders, "May they have joy
      and peace."'
    addEcon: 0
    addInfrastructure: 1
    addTowerHealth: 0
    econ: 0
    infrastructure: {fileID: 11400000, guid: dc834ba6316a564488617447656a6623, type: 2}
    towerHealth: 0
  - paragraph: "Trolls retreat into the mist, leaving shattered walls behind. The
      queen watches them go, whispering, \u201CWe\u2019ll rebuild again.\u201D"
    addEcon: 0
    addInfrastructure: 1
    addTowerHealth: 1
    econ: 0
    infrastructure: {fileID: 11400000, guid: 9ab883eb9ce71c843ba63c82619b7649, type: 2}
    towerHealth: -50
  - paragraph: "The royal treasury glimmers once more. Gold from the mines pours
      in, enough to mend walls and pay soldiers \u2014 for now."
    addEcon: 1
    addInfrastructure: 0
    addTowerHealth: 0
    econ: 400
    infrastructure: {fileID: 0}
    towerHealth: 0
